#!/bin/bash
# Exact continuation of the three KDA paper runs that reached checkpoint 28000
# before the original eight-hour allocation expired.
#SBATCH --job-name=sigma0-zoo-kda-resume
#SBATCH --array=9-11%3
#SBATCH --nodes=4
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:4
#SBATCH --mem=0
#SBATCH --time=02:00:00
#SBATCH --output=model_zoo_kda_resume_%A_%a.out
#SBATCH --error=model_zoo_kda_resume_%A_%a.err

set -euo pipefail

WORKDIR="${WORKDIR:-${SLURM_SUBMIT_DIR:-$(pwd)}}"
EXPECTED_COMMIT="${EXPECTED_COMMIT:-$(git -C "$WORKDIR" rev-parse HEAD)}"
TASK_ID=${SLURM_ARRAY_TASK_ID:?SLURM_ARRAY_TASK_ID is required}

case "$TASK_ID" in
    9)
        export WANDB_RUN_ID=e2fdixnm
        export WANDB_NAME=j5801558
        ;;
    10)
        export WANDB_RUN_ID=kahh38wg
        export WANDB_NAME=j5801559
        ;;
    11)
        export WANDB_RUN_ID=w8wsnxa9
        export WANDB_NAME=j5800866
        ;;
    *)
        echo "KDA continuation only supports array tasks 9-11, got $TASK_ID" >&2
        exit 2
        ;;
esac

export WORKDIR EXPECTED_COMMIT
export MODEL_ZOO_RESUME_STEP=28000
export OPTIMIZER_STEPS=30000
export MAX_JOB_HOURS=1.75

exec bash "$WORKDIR/run/base_model/model_zoo_production_array.batch"
