#!/bin/bash
# Fixed-window January-2026 generation from exact 30k paper checkpoints.
# One array task uses four independent single-GPU processes with interleaved,
# common sample indices. LOBBench scoring is deliberately a separate CPU job.
#SBATCH --job-name=sigma0-zoo-generate
#SBATCH --array=0-14%3
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:4
#SBATCH --cpus-per-task=32
#SBATCH --mem=0
#SBATCH --time=04:00:00
#SBATCH --output=model_zoo_generate_%A_%a.out
#SBATCH --error=model_zoo_generate_%A_%a.err

set -euo pipefail

ARCHITECTURES=(mamba3 s5 gdn kda transformer)
TRAIN_SEEDS=(5 42 137)
TASK_ID=${SLURM_ARRAY_TASK_ID:?SLURM_ARRAY_TASK_ID is required}
ARCH_INDEX=$((TASK_ID / ${#TRAIN_SEEDS[@]}))
SEED_INDEX=$((TASK_ID % ${#TRAIN_SEEDS[@]}))
if [ "$ARCH_INDEX" -ge "${#ARCHITECTURES[@]}" ]; then
    echo "Invalid paper-model generation task: $TASK_ID" >&2
    exit 2
fi

ARCHITECTURE=${ARCHITECTURES[$ARCH_INDEX]}
TRAIN_SEED=${TRAIN_SEEDS[$SEED_INDEX]}
WORKDIR="${WORKDIR:-${SLURM_SUBMIT_DIR:-$(pwd)}}"
MODEL_ZOO_ARTIFACT_ROOT="${MODEL_ZOO_ARTIFACT_ROOT:?MODEL_ZOO_ARTIFACT_ROOT is required}"
QUANT_ROOT="${QUANT_ROOT:-/lus/lfs1aip2/projects/public/s5e/quant_team/quant}"
PYTHON="${PYTHON:-$QUANT_ROOT/miniforge3/bin/python}"
BENCHMARK_ROOT="${LOBBENCH_ROOT:-$QUANT_ROOT/AlphaTrade/lob_pipeline}"
CHECKPOINT_STEP="${EVALUATION_CHECKPOINT_STEP:-30000}"
CHECKPOINT_PATH="$MODEL_ZOO_ARTIFACT_ROOT/checkpoints/$ARCHITECTURE/seed_$TRAIN_SEED/run"
EVALUATION_OUTPUT_DIRNAME="${EVALUATION_OUTPUT_DIRNAME:-evaluation_30k}"
OUTPUT_ROOT="$MODEL_ZOO_ARTIFACT_ROOT/$EVALUATION_OUTPUT_DIRNAME/$ARCHITECTURE/seed_$TRAIN_SEED"
INFERENCE_DIR="$OUTPUT_ROOT/inference"
COMPLETE_MANIFEST="$OUTPUT_ROOT/generation_complete.json"
JOB_TMP="/tmp/${USER:-${LOGNAME:-unknown}}/sigma0/${SLURM_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
N_SEQUENCES="${LOBBENCH_N_SEQUENCES:-3136}"
BATCH_SIZE="${INFERENCE_BATCH_SIZE:-8}"
WORLD_SIZE=4
N_COND_MSGS="${N_COND_MSGS:-250}"
N_GEN_MSGS="${N_GEN_MSGS:-250}"
SAMPLE_INDICES_FILE="${SAMPLE_INDICES_FILE:-$WORKDIR/run/benchmarking/model_zoo_GOOG_jan2026_3136_seq500_seed42.txt}"

CURRENT_COMMIT=$(git -C "$WORKDIR" rev-parse HEAD)
if [ -n "${EXPECTED_COMMIT:-}" ] && [ "$CURRENT_COMMIT" != "$EXPECTED_COMMIT" ]; then
    echo "Refusing code drift: expected $EXPECTED_COMMIT, found $CURRENT_COMMIT" >&2
    exit 2
fi
if [ $((N_SEQUENCES % (WORLD_SIZE * BATCH_SIZE))) -ne 0 ]; then
    echo "Refusing padded evaluation pool: $N_SEQUENCES is not divisible by $WORLD_SIZE x $BATCH_SIZE" >&2
    exit 2
fi
if [ ! -f "$SAMPLE_INDICES_FILE" ]; then
    echo "Missing canonical LOBBench sample-index file: $SAMPLE_INDICES_FILE" >&2
    exit 2
fi
CURRENT_SAMPLE_INDICES_SHA256=$(sha256sum "$SAMPLE_INDICES_FILE" | awk '{print $1}')
if [ -n "${EXPECTED_SAMPLE_INDICES_SHA256:-}" ] && \
        [ "$CURRENT_SAMPLE_INDICES_SHA256" != "$EXPECTED_SAMPLE_INDICES_SHA256" ]; then
    echo "Refusing sample-index drift: expected $EXPECTED_SAMPLE_INDICES_SHA256, found $CURRENT_SAMPLE_INDICES_SHA256" >&2
    exit 2
fi

"$PYTHON" "$WORKDIR/run/benchmarking/validate_model_zoo_evaluation.py" checkpoint \
    "$CHECKPOINT_PATH" --architecture "$ARCHITECTURE" --seed "$TRAIN_SEED" \
    --step "$CHECKPOINT_STEP"

if [ -f "$COMPLETE_MANIFEST" ]; then
    echo "[generation] already complete: $COMPLETE_MANIFEST"
    exit 0
fi
if [ -d "$INFERENCE_DIR" ] && [ -n "$(find "$INFERENCE_DIR" -mindepth 1 -print -quit)" ]; then
    echo "Refusing to mix with incomplete production inference: $INFERENCE_DIR" >&2
    exit 2
fi

mkdir -p "$INFERENCE_DIR" "$OUTPUT_ROOT" "$JOB_TMP"
export TMPDIR="$JOB_TMP"
export MPLCONFIGDIR="$JOB_TMP/matplotlib"
mkdir -p "$MPLCONFIGDIR"

module load cuda/12.6
CONDA_PREFIX="$QUANT_ROOT/miniforge3"
NVIDIA_SITE="$CONDA_PREFIX/lib/python3.12/site-packages/nvidia"
TORCH_LIB="$CONDA_PREFIX/lib/python3.12/site-packages/torch/lib"
export PATH="$CONDA_PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$TORCH_LIB:$NVIDIA_SITE/cuda_nvrtc/lib:$NVIDIA_SITE/cuda_runtime/lib:$NVIDIA_SITE/cusparse/lib:$NVIDIA_SITE/cuda_cupti/lib:$NVIDIA_SITE/cufft/lib:$NVIDIA_SITE/nvjitlink/lib:$NVIDIA_SITE/cusolver/lib:$NVIDIA_SITE/nccl/lib:$NVIDIA_SITE/cublas/lib:$NVIDIA_SITE/cudnn/lib:$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="$WORKDIR/src:$WORKDIR:${PYTHONPATH:-}"
export PYTHONNOUSERSITE=1
export XLA_PYTHON_CLIENT_MEM_FRACTION="${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.90}"
"$PYTHON" -c 'import jax, torch; backend=jax.default_backend(); assert backend == "gpu", backend; print(f"[cuda-preflight] jax={backend} torch={torch.__version__}")'

source "$BENCHMARK_ROOT/pipeline/_squashfs_helpers.sh"
infer_squashfs_setup \
    GOOG "${INFERENCE_MONTHS:-2026-01}" \
    "${INFERENCE_SQUASHFS_DIR:-/lus/lfs1aip2/projects/public/s5e/quant_team/lob_preproc_sp500_squashfs}"
infer_squashfs_setup_wide_book \
    GOOG "${INFERENCE_MONTHS:-2026-01}" \
    "${WIDE_SQUASHFS_DIR:-/projects/public/s5e/quant_team/recon_2026-05/output/squashfs}" \
    "${WIDE_LEVELS:-500}"
trap infer_squashfs_cleanup EXIT

echo "[generation] task=$TASK_ID architecture=$ARCHITECTURE seed=$TRAIN_SEED checkpoint=$CHECKPOINT_STEP"
echo "[generation] sequences=$N_SEQUENCES cond=$N_COND_MSGS gen=$N_GEN_MSGS rng=${GENERATION_SEED:-2026}"
echo "[generation] fixed_indices=$SAMPLE_INDICES_FILE sha256=$CURRENT_SAMPLE_INDICES_SHA256"

PIDS=()
for LOCAL_RANK in 0 1 2 3; do
    RANK_TMP="$JOB_TMP/rank_$LOCAL_RANK"
    mkdir -p "$RANK_TMP"
    CUDA_VISIBLE_DEVICES=$LOCAL_RANK TMPDIR="$RANK_TMP" "$PYTHON" -u -B \
        "$WORKDIR/run/base_model/runtime/inference.py" \
        --architecture="$ARCHITECTURE" \
        --token_mode=26tok \
        --ckpt_path="$CHECKPOINT_PATH" \
        --checkpoint_step="$CHECKPOINT_STEP" \
        --data_dir="$INFER_DATA_DIR_NODE" \
        --wide_book_dir="$INFER_WIDE_BOOK_DIR_NODE" \
        --wide_levels="${WIDE_LEVELS:-500}" \
        --save_dir="$INFERENCE_DIR" \
        --stock=GOOG \
        --n_sequences="$N_SEQUENCES" \
        --batch_size="$BATCH_SIZE" \
        --n_cond_msgs="$N_COND_MSGS" \
        --n_gen_msgs="$N_GEN_MSGS" \
        --test_split=1.0 \
        --sample_indices_file="$SAMPLE_INDICES_FILE" \
        --seed="${GENERATION_SEED:-2026}" \
        --rank="$LOCAL_RANK" --world_size="$WORLD_SIZE" \
        > "$OUTPUT_ROOT/inference_rank${LOCAL_RANK}.log" 2>&1 &
    PIDS+=("$!")
done

INFERENCE_EXIT=0
for i in "${!PIDS[@]}"; do
    if ! wait "${PIDS[$i]}"; then
        echo "Inference rank $i failed; see $OUTPUT_ROOT/inference_rank${i}.log" >&2
        INFERENCE_EXIT=1
    fi
done
[ "$INFERENCE_EXIT" -eq 0 ] || exit "$INFERENCE_EXIT"

"$PYTHON" "$WORKDIR/run/benchmarking/validate_model_zoo_evaluation.py" inference \
    "$INFERENCE_DIR" --expected-sequences "$N_SEQUENCES" \
    --rows "$N_GEN_MSGS" --world-size "$WORLD_SIZE" \
    --expected-indices-file "$SAMPLE_INDICES_FILE" \
    --expected-dataset-length "${EXPECTED_DATASET_LENGTH:?EXPECTED_DATASET_LENGTH is required}" \
    > "$OUTPUT_ROOT/inference_inventory.json"

"$PYTHON" - "$OUTPUT_ROOT/inference_inventory.json" "$COMPLETE_MANIFEST" \
    "$ARCHITECTURE" "$TRAIN_SEED" "$CHECKPOINT_STEP" "$CURRENT_COMMIT" \
    "${EXPECTED_LOBBENCH_REVISION:-unknown}" <<'PY'
import json
import os
import sys
from pathlib import Path

inventory_path, output_path, architecture, seed, step, commit, benchmark_revision = sys.argv[1:]
payload = json.loads(Path(inventory_path).read_text(encoding="utf-8"))
payload.update({
    "architecture": architecture,
    "training_seed": int(seed),
    "checkpoint_step": int(step),
    "sigma0_commit": commit,
    "lobbench_revision": benchmark_revision,
    "generation_job_id": os.environ["SLURM_JOB_ID"],
    "generation_array_task_id": int(os.environ["SLURM_ARRAY_TASK_ID"]),
    "generation_seed": int(os.environ.get("GENERATION_SEED", "2026")),
    "conditioning_messages": int(os.environ.get("N_COND_MSGS", "250")),
    "generated_messages": int(os.environ.get("N_GEN_MSGS", "250")),
})
destination = Path(output_path)
temporary = destination.with_suffix(destination.suffix + f".tmp.{os.getpid()}")
temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
temporary.replace(destination)
PY

echo "[generation] complete manifest=$COMPLETE_MANIFEST"
