#!/bin/bash
# Full-size checkpoint -> short rollout -> one-feature LOBBench gate.
# The production generation array is submitted with an aftercorr dependency on
# this array so every architecture/seed proves its own restore and decode path.
#SBATCH --job-name=sigma0-zoo-infer-smoke
#SBATCH --array=0-14%5
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=115000M
#SBATCH --time=00:45:00
#SBATCH --output=model_zoo_infer_smoke_%A_%a.out
#SBATCH --error=model_zoo_infer_smoke_%A_%a.err

set -euo pipefail

ARCHITECTURES=(mamba3 s5 gdn kda transformer)
TRAIN_SEEDS=(5 42 137)
TASK_ID=${SLURM_ARRAY_TASK_ID:?SLURM_ARRAY_TASK_ID is required}
ARCH_INDEX=$((TASK_ID / ${#TRAIN_SEEDS[@]}))
SEED_INDEX=$((TASK_ID % ${#TRAIN_SEEDS[@]}))
if [ "$ARCH_INDEX" -ge "${#ARCHITECTURES[@]}" ]; then
    echo "Invalid paper-model inference smoke task: $TASK_ID" >&2
    exit 2
fi

ARCHITECTURE=${ARCHITECTURES[$ARCH_INDEX]}
TRAIN_SEED=${TRAIN_SEEDS[$SEED_INDEX]}
WORKDIR="${WORKDIR:-${SLURM_SUBMIT_DIR:-$(pwd)}}"
MODEL_ZOO_ARTIFACT_ROOT="${MODEL_ZOO_ARTIFACT_ROOT:?MODEL_ZOO_ARTIFACT_ROOT is required}"
QUANT_ROOT="${QUANT_ROOT:-/lus/lfs1aip2/projects/public/s5e/quant_team/quant}"
PYTHON="${PYTHON:-$QUANT_ROOT/miniforge3/bin/python}"
BENCHMARK_ROOT="${LOBBENCH_ROOT:-$QUANT_ROOT/AlphaTrade/lob_pipeline}"
CHECKPOINT_STEP="${EVALUATION_CHECKPOINT_STEP:-30000}"
CHECKPOINT_PATH="$MODEL_ZOO_ARTIFACT_ROOT/checkpoints/$ARCHITECTURE/seed_$TRAIN_SEED/run"
OUTPUT_ROOT="$MODEL_ZOO_ARTIFACT_ROOT/inference_smoke_30k/$ARCHITECTURE/seed_$TRAIN_SEED/job_${SLURM_JOB_ID}"
INFERENCE_DIR="$OUTPUT_ROOT/inference"
JOB_TMP="/tmp/${USER:-${LOGNAME:-unknown}}/sigma0/${SLURM_JOB_ID}_${SLURM_ARRAY_TASK_ID}"

CURRENT_COMMIT=$(git -C "$WORKDIR" rev-parse HEAD)
if [ -n "${EXPECTED_COMMIT:-}" ] && [ "$CURRENT_COMMIT" != "$EXPECTED_COMMIT" ]; then
    echo "Refusing code drift: expected $EXPECTED_COMMIT, found $CURRENT_COMMIT" >&2
    exit 2
fi

"$PYTHON" "$WORKDIR/run/benchmarking/validate_model_zoo_evaluation.py" checkpoint \
    "$CHECKPOINT_PATH" --architecture "$ARCHITECTURE" --seed "$TRAIN_SEED" \
    --step "$CHECKPOINT_STEP"

mkdir -p "$INFERENCE_DIR" "$OUTPUT_ROOT" "$JOB_TMP"
export TMPDIR="$JOB_TMP"
export MPLCONFIGDIR="$JOB_TMP/matplotlib"
mkdir -p "$MPLCONFIGDIR"

module load cuda/12.6
CONDA_PREFIX="$QUANT_ROOT/miniforge3"
NVIDIA_SITE="$CONDA_PREFIX/lib/python3.12/site-packages/nvidia"
TORCH_LIB="$CONDA_PREFIX/lib/python3.12/site-packages/torch/lib"
export PATH="$CONDA_PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$TORCH_LIB:$NVIDIA_SITE/cuda_nvrtc/lib:$NVIDIA_SITE/cuda_runtime/lib:$NVIDIA_SITE/cusparse/lib:$NVIDIA_SITE/cuda_cupti/lib:$NVIDIA_SITE/cufft/lib:$NVIDIA_SITE/nvjitlink/lib:$NVIDIA_SITE/cusolver/lib:$NVIDIA_SITE/nccl/lib:$NVIDIA_SITE/cublas/lib:$NVIDIA_SITE/cudnn/lib:$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="$WORKDIR/src:$WORKDIR:${PYTHONPATH:-}"
export PYTHONNOUSERSITE=1
export XLA_PYTHON_CLIENT_MEM_FRACTION="${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.90}"
"$PYTHON" -c 'import jax, torch; backend=jax.default_backend(); assert backend == "gpu", backend; print(f"[cuda-preflight] jax={backend} torch={torch.__version__}")'

source "$BENCHMARK_ROOT/pipeline/_squashfs_helpers.sh"
infer_squashfs_setup \
    GOOG "${INFERENCE_MONTHS:-2026-01}" \
    "${INFERENCE_SQUASHFS_DIR:-/lus/lfs1aip2/projects/public/s5e/quant_team/lob_preproc_sp500_squashfs}"
infer_squashfs_setup_wide_book \
    GOOG "${INFERENCE_MONTHS:-2026-01}" \
    "${WIDE_SQUASHFS_DIR:-/projects/public/s5e/quant_team/recon_2026-05/output/squashfs}" \
    "${WIDE_LEVELS:-500}"
trap infer_squashfs_cleanup EXIT

echo "[checkpoint-inference-smoke] task=$TASK_ID architecture=$ARCHITECTURE seed=$TRAIN_SEED step=$CHECKPOINT_STEP"
"$PYTHON" -u -B "$WORKDIR/run/base_model/runtime/inference.py" \
    --architecture="$ARCHITECTURE" \
    --token_mode=26tok \
    --ckpt_path="$CHECKPOINT_PATH" \
    --checkpoint_step="$CHECKPOINT_STEP" \
    --data_dir="$INFER_DATA_DIR_NODE" \
    --wide_book_dir="$INFER_WIDE_BOOK_DIR_NODE" \
    --wide_levels="${WIDE_LEVELS:-500}" \
    --save_dir="$INFERENCE_DIR" \
    --stock=GOOG \
    --n_sequences=8 \
    --batch_size=1 \
    --n_cond_msgs=32 \
    --n_gen_msgs=32 \
    --seed="${GENERATION_SEED:-2026}"

"$PYTHON" "$WORKDIR/run/benchmarking/validate_model_zoo_evaluation.py" inference \
    "$INFERENCE_DIR" --expected-sequences 8 --rows 32 --world-size 1 \
    > "$OUTPUT_ROOT/inference_inventory.json"

"$PYTHON" -u -B "$WORKDIR/run/benchmarking/run_lobbench.py" \
    --run-name="sigma0-${ARCHITECTURE}-s${TRAIN_SEED}-30k-smoke" \
    --inference-dir="$INFERENCE_DIR" \
    --output-dir="$OUTPUT_ROOT/lobbench" \
    --stock=GOOG --period=2026-01 \
    --benchmark-root="$BENCHMARK_ROOT" \
    --python="$PYTHON" --n-workers=4 \
    --features=spread \
    --run-id="smoke-${SLURM_JOB_ID}" \
    --summary="$OUTPUT_ROOT/lobbench_summary.json"

echo "[checkpoint-inference-smoke] complete summary=$OUTPUT_ROOT/lobbench_summary.json"

